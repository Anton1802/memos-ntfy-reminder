# ===== Memos =====
# Адрес инстанса, без слэша в конце
MEMOS_URL=http://127.0.0.1:5230

# Access Token из UI: Настройки → Access Tokens → Create
MEMOS_TOKEN=eyJhbGciOi...

# /api/v1 для новых версий, /api для старых (проверить curl'ом)
MEMOS_API_PREFIX=/api/v1

# ===== ntfy =====
# База ntfy, без слэша в конце
NTFY_URL=http://127.0.0.1:8080

# Топик, куда слать уведомления
NTFY_TOPIC=reminders

# Пусто, если ntfy без авторизации. Иначе Bearer-токен
NTFY_TOKEN=

# ===== Триггеры =====
# Фразы через запятую, регистронезависимо
TRIGGER_PHRASES=напомни,напоминание,напомнить,сделать напоминание,remind

# ===== Время =====
# Часовой пояс для парсинга «в 18:00», «завтра в 9»
TZ=Europe/Moscow

# Если в заметке нет времени — через сколько минут напоминать
TRIGGER_DEFAULT_MINUTES=60

# ===== Поллер =====
# Интервал опроса Memos, сек
POLL_INTERVAL=30

# При первом запуске брать заметки только за последние N сек
FIRST_RUN_LOOKBACK=3600

# ===== Воркер =====
# Интервал проверки due-напоминаний, сек
WORKER_INTERVAL=30

# ===== Хранилище =====
# Путь к SQLite-базе
DB_PATH=data/reminders.db

# ===== Вебхук (опционально, пока не используется) =====
# Секрет для защиты эндпоинта, если включишь вебхук
WEBHOOK_SECRET=

# ===== Логи =====
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO